{
  "expo": {
    "name": "AIMEDIX MEDS HEALTHCARE",
    "slug": "customerApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/appicon.png",
    "scheme": "customerapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/appicon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/appicon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.harshsppandey.customerApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/appicon.png"
    },
    "plugins": [
      "expo-router",
      "react-native-maps",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/appicon-splash.png",
          "imageWidth": 300
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eee58970-bda3-4be9-af8b-a400cad3c2dd"
      }
    }
  }
}
